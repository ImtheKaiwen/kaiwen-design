{
  "name": "kaiwen-design-system",
  "private": true,
  "description": "Production-grade, modular design system and component library for Kaiwen Web and Mobile.",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.5.2"
}
