{
  "name": "@imthekaiwen/ui-web",
  "version": "0.2.0",
  "description": "Accessible React components for the Kaiwen Design System.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImtheKaiwen/kaiwen-design.git",
    "directory": "packages/ui-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js",
      "default": "./dist/patterns/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "import": "./dist/layouts/index.js",
      "default": "./dist/layouts/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./component-manifest.json": "./dist/component-manifest.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/layouts/index.ts src/patterns/index.ts src/data/index.ts src/styles.css --format esm --dts --clean --external react --external react-dom && node ../../tooling/check-component-manifest.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "docs:check": "node ../../tooling/check-component-manifest.mjs"
  },
  "dependencies": {
    "@imthekaiwen/icons": "0.2.0",
    "@imthekaiwen/motion": "0.2.0",
    "@imthekaiwen/tokens": "0.2.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "motion": "14.6.0"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "8.5.1",
    "vitest": "3.2.7"
  }
}
